{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "urspace-bootstrap",
  "main": "src/index.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "*.urspace.online/*",
      "zone_name": "urspace.online"
    }
  ],
  "assets": {
    "directory": "../../apps/bootstrap/public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
